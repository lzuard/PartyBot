<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>PartyBot-local-development</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all"/>
        <PackageReference Include="Telegram.Bot" Version="22.10.3.3"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="appsettings*.json;Content/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
