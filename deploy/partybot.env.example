# Copy to partybot.env (gitignored), chmod 600; replace every PLACEHOLDER before production.
# Polling remains disabled until explicitly enabled for the one intended instance.
Bot__PollingEnabled=false
Bot__BotToken=PLACEHOLDER
Bot__SuperAdminUserId=0
Bot__OrganizerUserIds__0=0
Bot__ModerationChatId=0
Bot__ArchiveChatId=0
Bot__AuditChatId=0
# Bot__AuditThreadId=1
Bot__SkipCooldownMinutes=1
Bot__SubmitCooldownMinutes=1
# N1/N2 above are DEVELOPMENT PLACEHOLDERS, not agreed production values.
Bot__DisplayTimeZone=Europe/Moscow
